{
  "name": "prokope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prokopē: um pouco de progresso, todo dia. App pessoal de hábitos (PWA).",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
