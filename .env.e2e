# Testes (npm run test:e2e, vite build --mode e2e): sempre na demonstração, mesmo com o Firebase no .env.local. Este arquivo vem antes do .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# O Zeno não se oferece sozinho nos testes (o tutorial é ligado pela API ou por Ajustes)
VITE_TOUR_AUTO=off
