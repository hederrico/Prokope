# Configuração do Firebase (não é segredo: vai junto com o app no navegador).
# Copie para .env.local e preencha com a saída de `firebase apps:sdkconfig web` (passo a passo em docs/firebase.md).
# Sem estas chaves, o app roda no modo demonstração, com os dados só no aparelho.

VITE_FIREBASE_API_KEY=
# Use o domínio do Hosting (prokope-app.web.app) para o login funcionar no app instalado no iPhone.
VITE_FIREBASE_AUTH_DOMAIN=prokope-app.web.app
VITE_FIREBASE_PROJECT_ID=prokope-app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
